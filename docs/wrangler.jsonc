{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "origami-docs",
  "main": "worker.ts",
  "compatibility_date": "2026-11-18",
  "routes": [{ "pattern": "origami.video", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../origami-site/out"
  },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "origami-downloads" }]
}
